{
	"name": "web",
	"description": "A web app for learning with LibreLingo courses",
	"version": "1.33.0",
	"type": "module",
	"private": true,
	"scripts": {
		"prepareCourses": "node ./scripts/prepareCourses.js && node ./scripts/buildIndex.js",
		"predev": "npm run prepareCourses",
		"prebuild": "npm run prepareCourses",
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"types": "tsc && svelte-check --treshold error",
		"installCourse": "./scripts/installExternalCourse.sh",
		"installAllExternalCourses": "python ./scripts/installExternalCourses.py",
		"installSelectedCourses": "python ./scripts/installCustomCourses.py",
		"fetchAudios": "bash ./scripts/fetchAudios.sh",
		"test": "vitest run",
		"check:notes": "node ./scripts/checkNotes.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@types/node": "^22.10.7",
		"@types/showdown": "^2.0.6",
		"svelte": "^5.0.0",
		"svelte-check": "^4.6.0",
		"vitest": "^3.2.7"
	},
	"dependencies": {
		"leven": "^4.0.0",
		"showdown": "^2.1.0"
	}
}
